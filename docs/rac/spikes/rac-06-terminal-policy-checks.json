{
	"kind": "rac06-real-adapter",
	"platform": "darwin",
	"initialize": true,
	"threadPolicy": false,
	"liveRequested": false,
	"error": "policy_mismatch",
	"policyChecks": {
		"cwdMatches": true,
		"approvalPolicyOnRequest": true,
		"reviewerIsUser": true,
		"workspaceWriteSandbox": false,
		"networkDisabled": true,
		"slashTmpExcluded": false,
		"tmpdirExcluded": false,
		"runtimeRootsMatch": true,
		"writableRootsMatch": false
	},
	"diagnostics": {
		"permissionDenied": false,
		"authenticationFailed": false
	},
	"shutdown": {
		"exitedOnEof": true,
		"forced": true,
		"groupStopped": true
	}
}
